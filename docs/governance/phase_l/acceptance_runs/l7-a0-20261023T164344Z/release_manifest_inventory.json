{
  "builder_defaults": "Hashes VERSION, requirements-lock.txt, v1_public_contracts.json from exact HEAD; no default Native ZIP/Docker digest/runtime/live/signature metadata",
  "existing_schema": {
    "$id": "v1_release_manifest.v1.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "artifact_hashes": {
        "additionalProperties": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "type": "object"
      },
      "generated_at": {
        "format": "date-time",
        "type": "string"
      },
      "product_version": {
        "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
        "type": "string"
      },
      "release_commit": {
        "pattern": "^[0-9a-f]{40}$",
        "type": "string"
      },
      "release_tree_sha": {
        "pattern": "^[0-9a-f]{40}$",
        "type": "string"
      },
      "schema_version": {
        "const": "v1_release_manifest.v1"
      }
    },
    "required": [
      "schema_version",
      "product_version",
      "release_commit",
      "release_tree_sha",
      "artifact_hashes",
      "generated_at"
    ],
    "type": "object"
  },
