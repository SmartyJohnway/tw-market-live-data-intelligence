    },
    {
      "field": "Native artifact hash",
      "owner": "A6",
      "support": "OPAQUE_ARTIFACT_HASH_ONLY"
    },
    {
      "field": "Docker image digest",
      "owner": "A6",
      "support": "OPAQUE_ARTIFACT_HASH_ONLY"
    },
    {
      "field": "dependency lock identity",
      "owner": "A6",
      "support": "OPAQUE_ARTIFACT_HASH_ONLY"
    },
    {
      "field": "Python/runtime identity",
      "owner": "A6",
      "support": "NO_TYPED_FIELD"
    },
    {
      "field": "public contract version",
      "owner": "A6",
      "support": "NO_TYPED_FIELD"
    },
    {
      "field": "compatibility declaration",
      "owner": "A6",
