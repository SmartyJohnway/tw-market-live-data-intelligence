{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taiwan_market_identity_release_manifest.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "state", "created_at", "repository_commit", "producer_version", "producer_skill_contract_hash", "source_provenance", "source_content_hashes", "schema_versions", "release_index_schema_sha256", "release_qualification_schema_sha256", "release_manifest_schema_sha256", "index_sha256", "qualification_report_sha256", "record_count", "knowledge_universe_count", "execution_eligible_count", "quarantine_count"],
  "properties": {
    "schema_version": {"const": "taiwan_market_identity_release_manifest.v1"},
    "release_id": {"type": "string", "pattern": "^security-master-[0-9]{8}T[0-9]{6}Z$"},
    "state": {"const": "QUALIFIED"},
    "created_at": {"type": "string", "format": "date-time"},
    "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "producer_version": {"type": "string", "minLength": 1},
    "producer_skill_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_provenance": {"type": "object"},
    "source_content_hashes": {"type": "object"},
    "schema_versions": {"type": "object"},
    "release_index_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_qualification_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_manifest_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qualification_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_count": {"type": "integer", "minimum": 0},
    "knowledge_universe_count": {"type": "integer", "minimum": 0},
    "execution_eligible_count": {"type": "integer", "minimum": 0},
    "quarantine_count": {"type": "integer", "minimum": 0}
  }
}
