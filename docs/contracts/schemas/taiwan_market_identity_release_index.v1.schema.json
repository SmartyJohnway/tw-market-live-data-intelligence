{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taiwan_market_identity_release_index.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "record_count", "records", "source_provenance"],
  "properties": {
    "schema_version": {"const": "taiwan_market_identity_release_index.v1"},
    "release_id": {"type": "string", "pattern": "^security-master-[0-9]{8}T[0-9]{6}Z$"},
    "record_count": {"type": "integer", "minimum": 0},
    "records": {"type": "array", "items": {"type": "object"}},
    "source_provenance": {"type": "object"}
  }
}
