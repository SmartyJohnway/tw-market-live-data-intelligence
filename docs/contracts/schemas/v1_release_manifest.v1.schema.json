{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1_release_manifest.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_version",
    "release_commit",
    "release_tree_sha",
    "artifact_hashes",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "v1_release_manifest.v1"},
    "product_version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
