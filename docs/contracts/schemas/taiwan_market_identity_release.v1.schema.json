{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taiwan_market_identity_release.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "state", "manifest_sha256", "created_at"],
  "properties": {
    "schema_version": {"const": "taiwan_market_identity_release.v1"},
    "release_id": {"type": "string", "pattern": "^security-master-[0-9]{8}T[0-9]{6}Z$"},
    "state": {"const": "QUALIFIED"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
