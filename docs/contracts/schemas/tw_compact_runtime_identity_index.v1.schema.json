{
  "$id": "https://github.com/SmartyJohnway/tw-market-live-data-intelligence/docs/contracts/schemas/tw_compact_runtime_identity_index.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic compact projection preserving every field used or returned by the canonical Security Master resolver.",
  "properties": {
    "generated_at_utc": {
      "description": "Source-derived snapshot generation timestamp; never the compact execution wall clock.",
      "format": "date-time",
      "type": "string"
    },
    "index_id": {
      "minLength": 1,
      "type": "string"
    },
    "record_count": {
      "minimum": 0,
      "type": "integer"
    },
    "records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "canonical_target_id": {
            "pattern": "^(TWSE|TPEX):[A-Z0-9._-]{1,20}$",
            "type": "string"
          },
          "caveats": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "classification": {
            "additionalProperties": true,
            "properties": {
              "classification_status": {
                "type": "string"
              },
              "instrument_family": {
                "type": "string"
              },
              "instrument_type": {
                "type": "string"
              },
              "market": {
                "enum": [
                  "TWSE",
                  "TPEX"
                ]
              }
            },
            "required": [
              "market",
              "instrument_type",
              "instrument_family",
              "classification_status"
            ],
            "type": "object"
          },
          "execution_eligibility": {
            "additionalProperties": false,
            "properties": {
              "reason_codes": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "status": {
                "enum": [
                  "allowed",
                  "allowed_with_caveat",
                  "blocked"
                ]
              }
            },
            "required": [
              "status",
              "reason_codes"
            ],
            "type": "object"
          },
          "identity": {
            "additionalProperties": false,
            "properties": {
              "cfi": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "isin": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "security_code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "security_name_en": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "security_name_zh": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "security_code",
              "security_name_zh",
              "security_name_en",
              "isin",
              "cfi"
            ],
            "type": "object"
          },
          "lifecycle": {
            "additionalProperties": false,
            "properties": {
              "as_of": {
                "format": "date",
                "type": "string"
              },
              "basis_event_ids": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "events": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "resolution_status": {
                "type": "string"
              },
              "state": {
                "type": "string"
              }
            },
            "required": [
              "state",
              "resolution_status",
              "as_of",
              "basis_event_ids",
              "events"
            ],
            "type": "object"
          },
          "observation": {
            "additionalProperties": false,
            "properties": {
              "observed_at": {
                "format": "date-time",
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_updated_date": {
                "format": "date",
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "observed_at",
              "source_updated_date"
            ],
            "type": "object"
          },
          "record_hash": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "record_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "canonical_target_id",
          "record_id",
          "record_hash",
          "identity",
          "classification",
          "lifecycle",
          "execution_eligibility",
          "observation",
          "caveats"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "m8r_06_01c1b_compact_identity_index.v1"
    },
    "source_bundle_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_skill_contract_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_snapshot_artifact": {
      "const": "dryrun_snapshot.json"
    },
    "source_snapshot_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_snapshot_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "index_id",
    "source_bundle_id",
    "source_snapshot_id",
    "source_snapshot_artifact",
    "source_snapshot_sha256",
    "source_skill_contract_hash",
    "generated_at_utc",
    "record_count",
    "records"
  ],
  "title": "Taiwan Compact Runtime Identity Index",
  "type": "object"
}
