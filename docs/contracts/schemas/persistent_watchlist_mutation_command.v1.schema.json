{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "persistent_watchlist_mutation_command.v1.schema.json",
  "oneOf": [
    { "$ref": "#/$defs/create" }, { "$ref": "#/$defs/rename" },
    { "$ref": "#/$defs/watchlist" }, { "$ref": "#/$defs/add" },
    { "$ref": "#/$defs/entry" }, { "$ref": "#/$defs/enabled" },
    { "$ref": "#/$defs/reorder" }, { "$ref": "#/$defs/tags" },
    { "$ref": "#/$defs/notes" }, { "$ref": "#/$defs/rollback" },
    { "$ref": "#/$defs/import" }
  ],
  "$defs": {
    "base": { "type": "object", "properties": { "schema_version": { "const": "persistent_watchlist_mutation_command.v1" }, "actor_source": { "enum": ["human", "ai_assisted", "import", "migration", "rollback", "system_metadata_reconcile"] } }, "required": ["schema_version", "command_type", "actor_source"] },
    "watchlist_id": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "entry_id": { "type": "string", "format": "uuid" },
    "create": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "schema_version": { "const": "persistent_watchlist_mutation_command.v1" }, "command_type": { "const": "create_watchlist" }, "actor_source": { "enum": ["human", "ai_assisted", "import", "migration", "rollback", "system_metadata_reconcile"] }, "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "set_default": { "type": "boolean" } } }] },
    "rename": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "additionalProperties": false, "required": ["watchlist_id", "expected_version", "name"], "properties": { "schema_version": { "const": "persistent_watchlist_mutation_command.v1" }, "command_type": { "const": "rename_watchlist" }, "actor_source": { "enum": ["human", "ai_assisted", "import", "migration", "rollback", "system_metadata_reconcile"] }, "watchlist_id": { "$ref": "#/$defs/watchlist_id" }, "expected_version": { "$ref": "#/$defs/version" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 } } }] },
    "watchlist": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "additionalProperties": false, "required": ["watchlist_id", "expected_version"], "properties": { "schema_version": { "const": "persistent_watchlist_mutation_command.v1" }, "command_type": { "enum": ["set_default_watchlist", "delete_watchlist", "restore_watchlist"] }, "actor_source": { "enum": ["human", "ai_assisted", "import", "migration", "rollback", "system_metadata_reconcile"] }, "watchlist_id": { "$ref": "#/$defs/watchlist_id" }, "expected_version": { "$ref": "#/$defs/version" } } }] },
    "add": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "additionalProperties": false, "required": ["watchlist_id", "expected_version", "query"], "properties": { "schema_version": { "const": "persistent_watchlist_mutation_command.v1" }, "command_type": { "const": "add_entry" }, "actor_source": { "enum": ["human", "ai_assisted", "import", "migration", "rollback", "system_metadata_reconcile"] }, "watchlist_id": { "$ref": "#/$defs/watchlist_id" }, "expected_version": { "$ref": "#/$defs/version" }, "query": { "type": "string", "minLength": 1, "maxLength": 256 }, "market_hint": { "type": "string", "maxLength": 16 }, "enabled": { "type": "boolean" }, "tags": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }, "notes": { "type": "string", "maxLength": 4096 } } }] },
    "entry": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "additionalProperties": false, "required": ["watchlist_id", "expected_version", "watchlist_entry_id"], "properties": { "schema_version": { "const": "persistent_watchlist_mutation_command.v1" }, "command_type": { "enum": ["remove_entry", "confirm_identity_migration"] }, "actor_source": { "enum": ["human", "ai_assisted", "import", "migration", "rollback", "system_metadata_reconcile"] }, "watchlist_id": { "$ref": "#/$defs/watchlist_id" }, "expected_version": { "$ref": "#/$defs/version" }, "watchlist_entry_id": { "$ref": "#/$defs/entry_id" } } }] },
    "enabled": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "additionalProperties": false, "required": ["watchlist_id", "expected_version", "watchlist_entry_id", "enabled"], "properties": { "schema_version": { "const": "persistent_watchlist_mutation_command.v1" }, "command_type": { "const": "set_entry_enabled" }, "actor_source": { "enum": ["human", "ai_assisted", "import", "migration", "rollback", "system_metadata_reconcile"] }, "watchlist_id": { "$ref": "#/$defs/watchlist_id" }, "expected_version": { "$ref": "#/$defs/version" }, "watchlist_entry_id": { "$ref": "#/$defs/entry_id" }, "enabled": { "type": "boolean" } } }] },
    "reorder": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "additionalProperties": false, "required": ["watchlist_id", "expected_version", "watchlist_entry_ids"], "properties": { "schema_version": { "const": "persistent_watchlist_mutation_command.v1" }, "command_type": { "const": "reorder_entries" }, "actor_source": { "enum": ["human", "ai_assisted", "import", "migration", "rollback", "system_metadata_reconcile"] }, "watchlist_id": { "$ref": "#/$defs/watchlist_id" }, "expected_version": { "$ref": "#/$defs/version" }, "watchlist_entry_ids": { "type": "array", "items": { "$ref": "#/$defs/entry_id" }, "uniqueItems": true } } }] },
    "tags": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "additionalProperties": false, "required": ["watchlist_id", "expected_version", "watchlist_entry_id", "tags"], "properties": { "schema_version": { "const": "persistent_watchlist_mutation_command.v1" }, "command_type": { "const": "set_entry_tags" }, "actor_source": { "enum": ["human", "ai_assisted", "import", "migration", "rollback", "system_metadata_reconcile"] }, "watchlist_id": { "$ref": "#/$defs/watchlist_id" }, "expected_version": { "$ref": "#/$defs/version" }, "watchlist_entry_id": { "$ref": "#/$defs/entry_id" }, "tags": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 64 } } } }] },
    "notes": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "additionalProperties": false, "required": ["watchlist_id", "expected_version", "watchlist_entry_id", "notes"], "properties": { "schema_version": { "const": "persistent_watchlist_mutation_command.v1" }, "command_type": { "const": "set_entry_notes" }, "actor_source": { "enum": ["human", "ai_assisted", "import", "migration", "rollback", "system_metadata_reconcile"] }, "watchlist_id": { "$ref": "#/$defs/watchlist_id" }, "expected_version": { "$ref": "#/$defs/version" }, "watchlist_entry_id": { "$ref": "#/$defs/entry_id" }, "notes": { "type": "string", "maxLength": 4096 } } }] },
    "rollback": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "additionalProperties": false, "required": ["watchlist_id", "expected_version", "target_version"], "properties": { "schema_version": { "const": "persistent_watchlist_mutation_command.v1" }, "command_type": { "const": "rollback_watchlist" }, "actor_source": { "enum": ["human", "ai_assisted", "import", "migration", "rollback", "system_metadata_reconcile"] }, "watchlist_id": { "$ref": "#/$defs/watchlist_id" }, "expected_version": { "$ref": "#/$defs/version" }, "target_version": { "$ref": "#/$defs/version" } } }] },
    "import": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "additionalProperties": false, "required": ["watchlist_id", "expected_version", "legacy_watchlist"], "properties": { "schema_version": { "const": "persistent_watchlist_mutation_command.v1" }, "command_type": { "const": "import_legacy_watchlist" }, "actor_source": { "const": "import" }, "watchlist_id": { "$ref": "#/$defs/watchlist_id" }, "expected_version": { "$ref": "#/$defs/version" }, "legacy_watchlist": { "type": "object" } } }] }
  }
}
