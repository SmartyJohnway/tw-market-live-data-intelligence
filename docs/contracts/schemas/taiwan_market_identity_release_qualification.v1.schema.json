{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taiwan_market_identity_release_qualification.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "status", "validated_at", "checks", "reason_codes", "counts"],
  "properties": {
    "schema_version": {"const": "taiwan_market_identity_release_qualification.v1"},
    "release_id": {"type": "string", "pattern": "^security-master-[0-9]{8}T[0-9]{6}Z$"},
    "status": {"enum": ["PASS", "FAIL"]},
    "validated_at": {"type": "string", "format": "date-time"},
    "checks": {"type": "array", "items": {"type": "object"}},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "counts": {"type": "object"}
  }
}
