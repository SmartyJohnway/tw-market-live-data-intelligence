{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unified_market_evidence_finalization_journal.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "journal_id",
    "finalization_owner_id",
    "authorization_id",
    "authorization_hash",
    "claim_id",
    "claim_hash",
    "preflight_id",
    "preflight_identity_hash",
    "preflight_artifact_hash",
    "execution_receipt_id",
    "execution_receipt_hash",
    "bundle_id",
    "bundle_hash",
    "state",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "unified_market_evidence_finalization_journal.v1"
    },
    "journal_id": {
      "type": "string",
      "pattern": "^umefj-v1-[0-9a-f]{20}$"
    },
    "finalization_owner_id": {
      "type": "string",
      "pattern": "^umefo-v1-[0-9a-f]{20}$"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^umea-v1-[0-9a-f]{20}$"
    },
    "authorization_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^umecl-v1-[0-9a-f]{20}$"
    },
    "claim_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preflight_id": {
      "type": "string",
      "pattern": "^umeopf-v1-[0-9a-f]{20}$"
    },
    "preflight_identity_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preflight_artifact_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_receipt_id": {
      "type": "string",
      "pattern": "^umerec-v1-[0-9a-f]{20}$"
    },
    "execution_receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^umeb-v1-[0-9a-f]{20}$"
    },
    "bundle_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "preparing",
        "artifacts_committed",
        "claim_committed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
