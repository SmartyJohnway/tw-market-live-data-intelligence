{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unified_market_evidence_execution_receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_receipt_id",
    "execution_receipt_hash",
    "preflight_id",
    "preflight_identity_hash",
    "preflight_artifact_hash",
    "claim_id",
    "claim_hash",
    "overall_status",
    "total_operations",
    "succeeded_operations",
    "failed_operations",
    "operation_receipts",
    "finalized_at",
    "created_by_component"
  ],
  "properties": {
    "schema_version": {
      "const": "unified_market_evidence_execution_receipt.v1"
    },
    "execution_receipt_id": {
      "type": "string",
      "pattern": "^umerec-v1-[0-9a-f]{20}$"
    },
    "execution_receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preflight_id": {
      "type": "string",
      "pattern": "^umeopf-v1-[0-9a-f]{20}$"
    },
    "preflight_identity_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preflight_artifact_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^umecl-v1-[0-9a-f]{20}$"
    },
    "claim_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "overall_status": {
      "enum": [
        "succeeded",
        "partial_success",
        "failed"
      ]
    },
    "total_operations": {
      "type": "integer",
      "minimum": 1
    },
    "succeeded_operations": {
      "type": "integer",
      "minimum": 0
    },
    "failed_operations": {
      "type": "integer",
      "minimum": 0
    },
    "operation_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "executor_id",
          "capability_id",
          "status",
          "error_code",
          "execution_request_id",
          "execution_request_hash",
          "result_item_count",
          "evidence_artifacts"
        ],
        "properties": {
          "operation_id": {
            "type": "string"
          },
          "executor_id": {
            "type": "string"
          },
          "capability_id": {
            "type": "string"
          },
          "status": {
            "enum": ["succeeded", "failed"]
          },
          "error_code": {
            "type": ["string", "null"]
          },
          "execution_request_id": {
            "type": "string",
            "pattern": "^umereq-v1-[0-9a-f]{20}$"
          },
          "execution_request_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "result_item_count": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "relative_path",
                "sha256",
                "schema_version",
                "byte_size",
                "item_count"
              ],
              "properties": {
                "relative_path": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "schema_version": { "type": "string" },
                "byte_size": { "type": "integer", "minimum": 0 },
                "item_count": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "finalized_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "created_by_component": {
      "type": "string"
    }
  }
}
