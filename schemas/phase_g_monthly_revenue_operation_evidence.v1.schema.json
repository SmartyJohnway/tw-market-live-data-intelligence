{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "target": {
      "type": "object",
      "required": [
        "canonical_target_id",
        "market",
        "security_code"
      ],
      "properties": {
        "canonical_target_id": {
          "type": "string",
          "minLength": 1
        },
        "market": {
          "enum": [
            "TWSE",
            "TPEX"
          ]
        },
        "security_code": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": [
        "transport",
        "failure"
      ],
      "properties": {
        "transport": {
          "enum": [
            "official_csv",
            "official_json_openapi"
          ]
        },
        "failure": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "source_company_codes"
          ],
          "properties": {
            "kind": {
              "const": "company_name_mismatch"
            },
            "source_company_codes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "normalized_record_hashes"
          ],
          "properties": {
            "kind": {
              "const": "binding_conflict"
            },
            "normalized_record_hashes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "minItems": 2
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "source_family",
        "source_contract_id",
        "transport",
        "fallback_used",
        "fallback_attempted",
        "attempt_failures"
      ],
      "properties": {
        "source_family": {},
        "source_contract_id": {},
        "transport": {
          "enum": [
            "official_csv",
            "official_json_openapi"
          ]
        },
        "fallback_used": {
          "type": "boolean"
        },
        "fallback_attempted": {
          "type": "boolean"
        },
        "attempt_failures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/attempt"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "fallback_used": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "transport": {
                "const": "official_json_openapi"
              },
              "fallback_attempted": {
                "const": true
              },
              "attempt_failures": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fallback_attempted": {
                "const": true
              },
              "fallback_used": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "attempt_failures": {
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fallback_attempted": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "fallback_used": {
                "const": false
              }
            }
          }
        }
      ]
    }
  },
  "$id": "urn:tw-market-live-data-intelligence:phase-g-monthly-revenue-operation-evidence:v1",
  "type": "object",
  "required": [
    "schema_version",
    "executor_id",
    "capability_id",
    "target",
    "status",
    "source",
    "observed_at",
    "coverage",
    "value",
    "diagnostics",
    "caveats"
  ],
  "properties": {
    "schema_version": {
      "const": "phase_g_monthly_revenue_operation_evidence.v1"
    },
    "executor_id": {
      "const": "phase_g_official_research_executor"
    },
    "capability_id": {
      "const": "monthly_revenue"
    },
    "target": {
      "$ref": "#/definitions/target"
    },
    "status": {
      "enum": [
        "available",
        "not_yet_available",
        "source_failed",
        "binding_failed"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "source_family",
        "source_contract_id",
        "transport",
        "fallback_used",
        "fallback_attempted",
        "attempt_failures"
      ],
      "properties": {
        "source_family": {
          "const": "MOPS_MONTHLY_REVENUE_OPEN_DATA"
        },
        "source_contract_id": {
          "enum": [
            "t187ap05_L",
            "t187ap05_O"
          ]
        },
        "transport": {
          "enum": [
            "official_csv",
            "official_json_openapi"
          ]
        },
        "fallback_used": {
          "type": "boolean"
        },
        "fallback_attempted": {
          "type": "boolean"
        },
        "attempt_failures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/attempt"
          }
        }
      },
      "additionalProperties": false
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/diagnostic"
      }
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "mode",
        "reporting_period",
        "source_report_date"
      ],
      "properties": {
        "mode": {
          "const": "latest_available_reporting_period"
        },
        "reporting_period": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "source_report_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "value": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "currency",
        "unit",
        "current_month_revenue",
        "previous_month_revenue",
        "previous_year_same_month_revenue",
        "mom_pct",
        "yoy_pct",
        "ytd_revenue",
        "previous_year_ytd_revenue",
        "ytd_yoy_pct",
        "note"
      ],
      "properties": {
        "currency": {
          "const": "TWD"
        },
        "unit": {
          "const": "thousand"
        },
        "current_month_revenue": {
          "type": [
            "integer",
            "null"
          ]
        },
        "previous_month_revenue": {
          "type": [
            "integer",
            "null"
          ]
        },
        "previous_year_same_month_revenue": {
          "type": [
            "integer",
            "null"
          ]
        },
        "mom_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "yoy_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "ytd_revenue": {
          "type": [
            "integer",
            "null"
          ]
        },
        "previous_year_ytd_revenue": {
          "type": [
            "integer",
            "null"
          ]
        },
        "ytd_yoy_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "available"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "not_yet_available",
              "source_failed",
              "binding_failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "status": {
                "not": {
                  "const": "source_failed"
                }
              }
            }
          },
          {
            "properties": {
              "source": {
                "properties": {
                  "fallback_attempted": {
                    "const": false
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "attempt_failures": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
