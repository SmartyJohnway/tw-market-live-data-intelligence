{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:tw-market-live-data-intelligence:material_disclosure_evidence:v1",
  "title": "Material Disclosure Evidence v1",
  "description": "Typed AI-facing evidence for the latest completed official material-disclosure daily batch.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "material_disclosure_evidence.v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "partial",
        "no_evidence_in_covered_scope",
        "not_yet_available",
        "not_applicable",
        "unsupported",
        "source_failed",
        "binding_failed"
      ]
    },
    "coverage": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "latest_completed_official_daily_batch"
        },
        "source_report_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "coverage_through": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "historical_lookup_supported": {
          "type": "boolean",
          "const": false
        },
        "item_count": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "source_report_date",
        "coverage_through",
        "historical_lookup_supported",
        "item_count",
        "truncated"
      ],
      "additionalProperties": false
    },
    "currentness": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "current_within_source_contract",
            "stale",
            "lagging",
            "unknown"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "status",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "authority": {
          "type": "string",
          "const": "official"
        },
        "source_family": {
          "type": "string",
          "minLength": 1
        },
        "market": {
          "type": "string",
          "enum": [
            "TWSE",
            "TPEX"
          ]
        },
        "source_contract_id": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "type": "string",
          "enum": [
            "official_csv",
            "official_json_openapi"
          ]
        },
        "fallback_used": {
          "type": "boolean"
        }
      },
      "required": [
        "authority",
        "source_family",
        "market",
        "source_contract_id",
        "transport",
        "fallback_used"
      ],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_fact_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "subject": {
            "type": "string"
          },
          "clause": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 8192
          },
          "description_truncated": {
            "type": "boolean"
          },
          "revision_relation": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "unresolved",
                  "officially_linked"
                ]
              },
              "relation_type": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "corrects",
                  "supplements",
                  "supersedes",
                  null
                ]
              },
              "related_official_reference": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "status",
              "relation_type",
              "related_official_reference"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "unresolved"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "relation_type": {
                      "type": "null"
                    },
                    "related_official_reference": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "officially_linked"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "relation_type": {
                      "type": "string",
                      "enum": [
                        "corrects",
                        "supplements",
                        "supersedes"
                      ]
                    },
                    "related_official_reference": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ],
            "additionalProperties": false
          },
          "citation_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "published_at",
          "source_fact_date",
          "subject",
          "clause",
          "description",
          "description_truncated",
          "revision_relation",
          "citation_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "citation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "status",
    "coverage",
    "currentness",
    "source",
    "items",
    "caveats",
    "citation_ids"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "available",
              "partial"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "no_evidence_in_covered_scope",
              "not_yet_available",
              "not_applicable",
              "unsupported",
              "source_failed",
              "binding_failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage": {
            "properties": {
              "truncated": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
