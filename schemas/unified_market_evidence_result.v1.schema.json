{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:tw-market-live-data-intelligence:unified_market_evidence_result:v1",
  "title": "Unified Market Evidence Result v1",
  "type": "object",
  "definitions": {
    "evidence_envelope": {
      "type": "object",
      "properties": {
        "status": {"type": "string"},
        "timing_class": {"type": "string"},
        "caveats": {
          "type": "array",
          "items": {"type": "string"}
        },
        "observed_fields": {
          "type": "object",
          "additionalProperties": true
        },
        "missing_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "currentness": {
          "type": "object",
          "additionalProperties": true
        },
        "fallback": {"type": "boolean"},
        "fallback_state": {"type": "string"},
        "citation_ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "derived_metric": {
      "type": "object",
      "properties": {
        "metric_id": {"type": "string"},
        "metric_name": {"type": "string"},
        "status": {
          "type": "string",
          "enum": ["available", "unavailable", "invalid", "not_requested"]
        },
        "value": {"type": ["number", "string", "null"]},
        "unit": {"type": ["string", "null"]},
        "method": {"type": ["string", "null"]},
        "formula_or_definition": {"type": ["string", "null"]},
        "window": {"type": ["string", "null"]},
        "input_evidence_references": {
          "type": "array",
          "items": {"type": "string"}
        },
        "calculation_version": {"type": ["string", "null"]},
        "calculated_at": {"type": ["string", "null"]},
        "invalid_reason": {"type": ["string", "null"]},
        "caveats": {
          "type": "array",
          "items": {"type": "string"}
        },
        "citation_ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": ["metric_id", "metric_name", "status"],
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "unified_market_evidence_result.v1"
    },
    "result_id": {
      "type": "string",
      "pattern": "^umeresult-v1-[0-9a-f]{20}$"
    },
    "result_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_summary": {
      "type": "object",
      "properties": {
        "execution_mode": {"type": ["string", "null"]},
        "target_count": {"type": "integer", "minimum": 0},
        "requested_data_needs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "required_data_needs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "optional_data_needs": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "required": [
        "target_count",
        "requested_data_needs",
        "required_data_needs",
        "optional_data_needs"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["full_success", "success_with_partial_coverage", "failed", "partially_failed"]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "client_target_reference": {"type": ["string", "null"]},
          "resolution": {
            "type": "object",
            "properties": {
              "status": {"type": "string", "enum": ["resolved", "ambiguous", "not_found", "market_hint_conflict", "unsupported_market"]},
              "canonical_target_id": {"type": ["string", "null"]},
              "security_code": {"type": ["string", "null"]},
              "security_name": {"type": ["string", "null"]},
              "market": {"type": ["string", "null"]}
            },
            "required": ["status"],
            "additionalProperties": false
          },
          "evidence": {
            "type": "object",
            "properties": {
              "identity": {"$ref": "#/definitions/evidence_envelope"},
              "current_observation": {"$ref": "#/definitions/evidence_envelope"},
              "official_eod_reference": {
                "type": "object",
                "properties": {
                  "trade_date": {"type": ["string", "null"]},
                  "expected_latest_completed_trade_date": {"type": ["string", "null"]},
                  "currentness_status": {
                    "type": "string",
                    "enum": [
                      "official_latest_completed_eod",
                      "official_previous_session_eod_before_close",
                      "not_yet_published_after_close",
                      "market_closed_no_session",
                      "unexpected_stale_eod",
                      "calendar_status_unresolved",
                      "future_trade_date_invalid",
                      "source_trade_date_missing",
                      "invalid_trade_date_format"
                    ]
                  },
                  "session_status": {"type": "string"},
                  "publication_grace_applied": {"type": "boolean"},
                  "fallback_policy_used": {"type": "boolean"},
                  "provisional_candidate_status": {"type": ["string", "null"]},
                  "caveats": {
                    "type": "array",
                    "items": {"type": "string"}
                  }
                },
                "required": ["currentness_status"],
                "additionalProperties": false
              },
              "recent_performance": {"$ref": "#/definitions/evidence_envelope"},
              "session_status": {"$ref": "#/definitions/evidence_envelope"},
              "source_currentness": {"$ref": "#/definitions/evidence_envelope"},
              "evidence_quality": {"$ref": "#/definitions/evidence_envelope"}
            },
            "additionalProperties": false
          },
          "derived_metrics": {
            "type": "array",
            "items": {"$ref": "#/definitions/derived_metric"}
          },
          "coverage": {
            "type": "object",
            "properties": {
              "provided_needs": {
                "type": "array",
                "items": {"type": "string"}
              },
              "missing_needs": {
                "type": "array",
                "items": {"type": "string"}
              }
            },
            "additionalProperties": false
          },
          "caveats": {
            "type": "array",
            "items": {"type": "string"}
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "citation_id": {"type": "string"},
                "source_family": {"type": "string"},
                "source_contract_id": {"type": "string"},
                "retrieved_at": {"type": "string", "format": "date-time"},
                "effective_trade_date": {"type": "string", "format": "date"},
                "artifact_reference": {
                  "type": "string",
                  "pattern": "^(?!([a-zA-Z]:\\\\|file://|/|\\\\)).+",
                  "description": "Must be a relative path or URI, not absolute local path"
                },
                "normalized_evidence_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
              },
              "required": ["citation_id", "source_family", "retrieved_at", "artifact_reference"],
              "additionalProperties": false
            }
          }
        },
        "required": ["resolution", "evidence"],
        "additionalProperties": false
      }
    },
    "partial_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_index": {"type": "integer"},
          "data_need": {"type": ["string", "null"]},
          "reason": {"type": "string"},
          "reason_code": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "request_caveats": {
      "type": "array",
      "items": {"type": "string"}
    },
    "audit_reference": {
      "type": "object",
      "properties": {
        "audit_package_id": {
          "type": "string",
          "pattern": "^umeap-v1-[0-9a-f]{20}$"
        },
        "schema_version": {
          "type": "string",
          "const": "unified_market_evidence_audit_package.v1"
        },
        "relative_path": {
          "type": "string",
          "pattern": "^(?!([a-zA-Z]:\\\\|file://|/|\\\\)).+"
        },
        "audit_id": {"type": "string"},
        "execution_time_ms": {"type": "integer"}
      },
      "required": ["audit_package_id", "schema_version", "relative_path"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "result_id",
    "result_hash",
    "request_id",
    "generated_at",
    "request_summary",
    "status",
    "targets"
  ],
  "additionalProperties": false
}
