{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unified_market_evidence_execution_request.v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_request_id", "execution_request_hash", "operation_id", "batch_group_id", "plan_id", "plan_hash", "authorization_id", "authorization_hash", "consumption_binding_id", "consumption_binding_hash", "market", "approved_security_identifiers", "approved_security_types", "capability_id", "executor_id", "requested_fields", "currentness_requirement", "maximum_records", "timeout_seconds", "network_authorized", "relative_contained_output_path", "parameters"],
  "properties": {
    "schema_version": {"const": "unified_market_evidence_execution_request.v3"},
    "execution_request_id": {"type": "string", "pattern": "^umereq-v3-[0-9a-f]{20}$"},
    "execution_request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation_id": {"type": "string", "pattern": "^umeop-op-v1-[0-9a-f]{20}$"},
    "batch_group_id": {"type": "string", "pattern": "^umeop-batch-v1-[0-9a-f]{20}$"},
    "plan_id": {"type": "string"}, "plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_id": {"type": "string", "pattern": "^umea-v1-[0-9a-f]{20}$"}, "authorization_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "consumption_binding_id": {"type": "string", "pattern": "^umeacb-v1-[0-9a-f]{20}$"}, "consumption_binding_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "market": {"enum": ["TWSE", "TPEX"]}, "approved_security_identifiers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "approved_security_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capability_id": {"enum": ["recent_performance", "index_futures_context", "cash_institutional_flow_context"]}, "executor_id": {"type": "string", "minLength": 1}, "requested_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "currentness_requirement": {"type": ["string", "null"]},
    "maximum_records": {"type": "integer", "minimum": 1, "maximum": 500}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60}, "network_authorized": {"type": "boolean"},
    "relative_contained_output_path": {"type": "string", "pattern": "^operations/umeop-op-v1-[0-9a-f]{20}\\.execution-request\\.json$"},
    "parameters": {"type": "object", "additionalProperties": false, "properties": {"lookback_trading_days": {"type": "integer", "minimum": 1, "maximum": 20}, "resolved_source_trade_date": {"type": "string", "format": "date"}}}
  },
  "allOf": [
    {"if": {"properties": {"capability_id": {"const": "recent_performance"}}, "required": ["capability_id"]}, "then": {"properties": {"parameters": {"required": ["lookback_trading_days"], "maxProperties": 1}}}},
    {"if": {"properties": {"capability_id": {"const": "index_futures_context"}}, "required": ["capability_id"]}, "then": {"properties": {"parameters": {"maxProperties": 0}}}},
    {"if": {"properties": {"capability_id": {"const": "cash_institutional_flow_context"}, "market": {"const": "TWSE"}}, "required": ["capability_id", "market"]}, "then": {"properties": {"parameters": {"required": ["resolved_source_trade_date"], "maxProperties": 1}}}},
    {"if": {"properties": {"capability_id": {"const": "cash_institutional_flow_context"}, "market": {"const": "TPEX"}}, "required": ["capability_id", "market"]}, "then": {"properties": {"parameters": {"maxProperties": 0}}}}
  ]
}
