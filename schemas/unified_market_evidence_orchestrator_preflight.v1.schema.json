{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unified_market_evidence_orchestrator_preflight.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preflight_id",
    "preflight_hash",
    "preflight_identity_hash",
    "preflight_artifact_hash",
    "preflight_identity_scope",
    "plan_id",
    "plan_hash",
    "authorization_id",
    "authorization_hash",
    "consumption_binding_id",
    "consumption_binding_hash",
    "scope_hash",
    "approved_operation_order",
    "resolved_operation_bindings",
    "resolved_batch_bindings",
    "resolved_executor_bindings",
    "bounded_execution_requests",
    "network_required",
    "network_authorized",
    "execution_authorized",
    "governed_output_root",
    "containment_status",
    "warnings",
    "blocking_errors",
    "ready_for_claim",
    "created_by_component"
  ],
  "properties": {
    "schema_version": { "const": "unified_market_evidence_orchestrator_preflight.v1" },
    "preflight_id": { "type": "string", "pattern": "^umeopf-v1-[0-9a-f]{20}$" },
    "preflight_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "preflight_identity_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "preflight_artifact_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "preflight_identity_scope": { "type": "object" },
    "plan_id": { "type": "string" },
    "plan_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authorization_id": { "type": "string", "pattern": "^umea-v1-[0-9a-f]{20}$" },
    "authorization_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "consumption_binding_id": { "type": "string", "pattern": "^umeacb-v1-[0-9a-f]{20}$" },
    "consumption_binding_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scope_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "approved_operation_order": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^umeop-op-v1-[0-9a-f]{20}$" },
      "uniqueItems": true
    },
    "resolved_operation_bindings": { "type": "object" },
    "resolved_batch_bindings": { "type": "object" },
    "resolved_executor_bindings": { "type": "object" },
    "bounded_execution_requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "execution_request_id",
          "execution_request_hash",
          "operation_id",
          "batch_group_id",
          "plan_id",
          "plan_hash",
          "authorization_id",
          "authorization_hash",
          "consumption_binding_id",
          "consumption_binding_hash",
          "market",
          "approved_security_identifiers",
          "approved_security_types",
          "capability_id",
          "executor_id",
          "requested_fields",
          "currentness_requirement",
          "maximum_records",
          "timeout_seconds",
          "network_authorized",
          "relative_contained_output_path"
        ],
        "properties": {
          "schema_version": { "const": "unified_market_evidence_execution_request.v1" },
          "execution_request_id": { "type": "string", "pattern": "^umereq-v1-[0-9a-f]{20}$" },
          "execution_request_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "operation_id": { "type": "string", "pattern": "^umeop-op-v1-[0-9a-f]{20}$" },
          "batch_group_id": { "type": "string", "pattern": "^umeop-batch-v1-[0-9a-f]{20}$" },
          "plan_id": { "type": "string" },
          "plan_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "authorization_id": { "type": "string", "pattern": "^umea-v1-[0-9a-f]{20}$" },
          "authorization_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "consumption_binding_id": { "type": "string", "pattern": "^umeacb-v1-[0-9a-f]{20}$" },
          "consumption_binding_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "market": { "type": ["string", "null"] },
          "approved_security_identifiers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "approved_security_types": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "capability_id": { "type": "string", "minLength": 1 },
          "executor_id": { "type": "string", "minLength": 1 },
          "requested_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "currentness_requirement": { "type": ["string", "null"] },
          "maximum_records": { "type": "integer", "minimum": 1, "maximum": 500 },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
          "network_authorized": { "type": "boolean" },
          "relative_contained_output_path": {
            "type": "string",
            "pattern": "^operations/umeop-op-v1-[0-9a-f]{20}\\.execution-request\\.json$"
          }
        },
        "additionalProperties": false
      }
    },
    "network_required": { "type": "boolean" },
    "network_authorized": { "type": "boolean" },
    "execution_authorized": { "type": "boolean" },
    "governed_output_root": { "type": "string", "minLength": 1 },
    "containment_status": { "const": "passed" },
    "warnings": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "blocking_errors": { "type": "array", "maxItems": 0 },
    "ready_for_claim": { "const": true },
    "created_by_component": { "const": "m8r_05b_03_preflight" }
  }
}
