{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unified_market_evidence_executor_registry_metadata.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "executors"],
  "properties": {
    "schema_version": {
      "const": "m8r_05b_03_executor_registry_metadata.v1"
    },
    "executors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "executor_id",
          "capability_id",
          "market",
          "supported_security_types",
          "expected_evidence_contract",
          "network_required",
          "bounded_execution_supported",
          "timeout_seconds",
          "maximum_result_items",
          "output_policy"
        ],
        "properties": {
          "executor_id": {"type": "string", "minLength": 1},
          "capability_id": {"type": "string", "minLength": 1},
          "market": {"type": "string", "minLength": 1},
          "supported_security_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "expected_evidence_contract": {"type": "string", "minLength": 1},
          "network_required": {"type": "boolean"},
          "bounded_execution_supported": {"type": "boolean"},
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "maximum_result_items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "output_policy": {
            "enum": ["contained_artifact_only", "no_raw_payload_retention"]
          }
        }
      }
    }
  }
}
