{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unified_market_evidence_bundle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_hash",
    "authorization_id",
    "preflight_id",
    "claim_id",
    "execution_receipt_id",
    "overall_status",
    "manifest_relative_path",
    "finalized_at"
  ],
  "properties": {
    "schema_version": {
      "const": "unified_market_evidence_bundle.v1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^umeb-v1-[0-9a-f]{20}$"
    },
    "bundle_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^umea-v1-[0-9a-f]{20}$"
    },
    "preflight_id": {
      "type": "string",
      "pattern": "^umeopf-v1-[0-9a-f]{20}$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^umecl-v1-[0-9a-f]{20}$"
    },
    "execution_receipt_id": {
      "type": "string",
      "pattern": "^umerec-v1-[0-9a-f]{20}$"
    },
    "overall_status": {
      "enum": [
        "succeeded",
        "partial_success",
        "failed"
      ]
    },
    "manifest_relative_path": {
      "type": "string"
    },
    "finalized_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
