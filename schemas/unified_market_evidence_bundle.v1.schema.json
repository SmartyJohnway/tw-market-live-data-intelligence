{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unified_market_evidence_bundle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_hash",
    "authorization_id",
    "authorization_hash",
    "preflight_id",
    "preflight_identity_hash",
    "preflight_artifact_hash",
    "claim_id",
    "claim_hash",
    "execution_receipt_id",
    "execution_receipt_hash",
    "overall_status",
    "operation_order",
    "operation_evidence_entries",
    "artifact_inventory",
    "total_item_count",
    "warnings",
    "finalized_at"
  ],
  "properties": {
    "schema_version": {
      "const": "unified_market_evidence_bundle.v1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^umeb-v1-[0-9a-f]{20}$"
    },
    "bundle_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^umea-v1-[0-9a-f]{20}$"
    },
    "authorization_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preflight_id": {
      "type": "string",
      "pattern": "^umeopf-v1-[0-9a-f]{20}$"
    },
    "preflight_identity_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preflight_artifact_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^umecl-v1-[0-9a-f]{20}$"
    },
    "claim_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "execution_receipt_id": {
      "type": "string",
      "pattern": "^umerec-v1-[0-9a-f]{20}$"
    },
    "execution_receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "overall_status": {
      "enum": [
        "succeeded",
        "partial_success",
        "failed"
      ]
    },
    "operation_order": {
      "type": "array",
      "items": { "type": "string" }
    },
    "operation_evidence_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "status",
          "error_code",
          "result_item_count",
          "artifacts",
          "warnings"
        ],
        "properties": {
          "operation_id": { "type": "string" },
          "status": { "enum": ["succeeded", "failed"] },
          "error_code": { "type": ["string", "null"] },
          "result_item_count": { "type": "integer", "minimum": 0 },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["relative_path", "sha256", "schema_version", "byte_size", "item_count"],
              "properties": {
                "relative_path": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "schema_version": { "type": "string" },
                "byte_size": { "type": "integer", "minimum": 0 },
                "item_count": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "warnings": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "artifact_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "sha256",
          "schema_version",
          "byte_size",
          "item_count",
          "evidence_contract"
        ],
        "properties": {
          "relative_path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "schema_version": { "type": "string" },
          "byte_size": { "type": "integer", "minimum": 0 },
          "item_count": { "type": "integer", "minimum": 0 },
          "evidence_contract": { "type": "string" }
        }
      }
    },
    "total_item_count": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "finalized_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
