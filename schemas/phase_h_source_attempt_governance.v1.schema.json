{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase H source-attempt governance sidecar v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_artifact_reference", "canonical_target_id", "capability_id", "attempts"],
  "properties": {
    "schema_version": {"const": "phase_h_source_attempt_governance.v1"},
    "evidence_artifact_reference": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
    "canonical_target_id": {"type": "string", "minLength": 1},
    "capability_id": {"enum": ["trading_status_context", "corporate_action_context", "recent_performance"]},
    "attempts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_family", "source_contract_id", "source_role", "activation_state", "provider_availability", "license_authority", "status", "failure_code", "citation_ids"],
        "properties": {
          "source_family": {"type": "string", "minLength": 1},
          "source_contract_id": {"type": "string", "minLength": 1},
          "source_role": {"enum": ["default_candidate", "governed_fallback", "optional_licensed_provider", "manual_verification", "research_only", "source_gap"]},
          "activation_state": {"enum": ["inactive", "eligible", "active", "blocked"]},
          "provider_availability": {"enum": ["available", "unavailable", "not_required", "unknown"]},
          "license_authority": {"type": ["string", "null"]},
          "status": {"enum": ["available", "complete", "partial", "no_evidence_in_covered_scope", "source_failed", "binding_failed"]},
          "failure_code": {"type": ["string", "null"]},
          "citation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
