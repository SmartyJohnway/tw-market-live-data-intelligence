{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unified_market_evidence_operation_result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "execution_request_id",
    "execution_request_hash",
    "executor_id",
    "capability_id",
    "evidence_contract",
    "status",
    "error_code",
    "result_item_count",
    "evidence_artifacts",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "unified_market_evidence_operation_result.v1"
    },
    "operation_id": {
      "type": "string"
    },
    "execution_request_id": {
      "type": "string",
      "pattern": "^umereq-v1-[0-9a-f]{20}$"
    },
    "execution_request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executor_id": {
      "type": "string"
    },
    "capability_id": {
      "type": "string"
    },
    "evidence_contract": {
      "type": "string"
    },
    "status": {
      "enum": ["succeeded", "failed"]
    },
    "error_code": {
      "type": ["string", "null"]
    },
    "result_item_count": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "sha256",
          "schema_version",
          "byte_size",
          "item_count"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "schema_version": {
            "type": "string",
            "minLength": 1
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          },
          "item_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "succeeded" } }
      },
      "then": {
        "properties": {
          "error_code": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "failed" } }
      },
      "then": {
        "properties": {
          "error_code": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
